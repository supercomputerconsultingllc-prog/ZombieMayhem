{
  "name": "zombie-squad-run-ios-webwrap",
  "version": "2.0.0",
  "private": true,
  "description": "Offline iOS packaging for Zombie Mayhem V2",
  "scripts": {
    "prepare:web": "node tools/prepare-web.js",
    "verify:v2": "node tools/verify-v2.js",
    "prepare:ios": "node tools/prepare-ios.js",
    "release:prep": "node tools/prepare-web.js && node tools/verify-v2.js --release",
    "validate:release": "node tools/validate-release.js",
    "check:placeholders": "node tools/check-placeholders.js",
    "check:assets": "node tools/check-assets.js",
    "generate:icon": "node tools/generate-icon.js",
    "capture:screenshots": "node tools/capture-screenshots.js",
    "polish:screenshots": "node tools/polish-screenshots.js",
    "build:hosted-pages": "node tools/build-hosted-pages.js",
    "apply:env-config": "node tools/apply-env-config.js",
    "set:pages-urls": "node tools/set-pages-urls.js",
    "check:monetization": "node tools/check-monetization-readiness.js",
    "generate:submission-packet": "node tools/generate-submission-packet.js",
    "finalize:release": "node tools/prepare-ios.js && node tools/verify-v2.js --release",
    "assets:starter-pack": "node tools/generate-icon.js && node tools/capture-screenshots.js && node tools/polish-screenshots.js && node tools/build-hosted-pages.js",
    "preflight": "node tools/verify-v2.js --release",
    "release:check": "node tools/verify-v2.js --release && node tools/check-xcode.js",
    "cap:init:notes": "node tools/print-next-steps.js"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/filesystem": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "esbuild": "0.28.2"
  },
  "overrides": { "xcode": { "uuid": "11.1.1" } },
  "engines": { "node": ">=22" }
}
